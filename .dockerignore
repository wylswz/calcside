.git
.github
.gitignore

# Build outputs and local state
bin
*.db
*.db-shm
*.db-wal
calcside.db*
calcside-dev.db*

# Frontend deps/artifacts (dist is rebuilt inside the image)
web/node_modules
web/dist

# Local env / secrets
.env
.env.*

# Docs, examples, and release assets not needed at runtime
docs
blog
examples
sdk
charts
dist

# Docker files themselves (the worker entrypoint is baked into the image)
docker
!docker/worker-entrypoint.sh
!docker/Dockerfile.migrate
!docker/atlas-release.hcl
.dockerignore

# Editor / OS noise
.DS_Store
.idea
.vscode
