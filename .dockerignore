.git
.github
.gitignore

# Build outputs and local state
bin
*.db
*.db-shm
*.db-wal
calcside.db*
calcside-dev.db*

# Frontend deps/artifacts (dist is rebuilt inside the image)
web/node_modules
web/dist

# Local env / secrets
.env
.env.*

# Docs and examples not needed at runtime (compose bind-mounts them in)
docs
blog
examples
sdk

# Docker files themselves (the worker entrypoint is baked into the image)
docker
!docker/worker-entrypoint.sh
.dockerignore

# Editor / OS noise
.DS_Store
.idea
.vscode
