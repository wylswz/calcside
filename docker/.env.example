# For a new deployment, copy this file to docker/.env and replace example values.
# If docker/.env already exists, merge the needed settings; preserve existing secrets.
# Compose reads docker/.env, NOT this .env.example file.
# After editing docker/.env, recreate services from the repository root:
#   docker compose -f docker/docker-compose.yml up -d
# A container restart alone does not reload environment variables.

# Loaded wholesale into BOTH services via env_file — every CALCSIDE_*
# flag/env documented in `calcside serve --help` / `calcside-worker
# serve --help` can be set here once and reaches the right process.

# Required: shared HMAC secret authenticating API↔worker calls.
# Generate: openssl rand -base64 32   (or just run `make docker-env`)
CALCSIDE_WORKER_SHARED_KEY=

# Optional: secrets vault key (openssl rand -base64 32). Without it the vault is disabled.
# CALCSIDE_SECRET_KEY=

# Optional: Google SSO.
# CALCSIDE_GOOGLE_CLIENT_ID=
# CALCSIDE_GOOGLE_CLIENT_SECRET=
# CALCSIDE_GOOGLE_ALLOWED_DOMAINS=

# Execution limits — apply to both services and must match:
# CALCSIDE_MAX_EXEC_TIMEOUT=5m
# CALCSIDE_MAX_STEPS=100000000
# CALCSIDE_MAX_INSTANCES_PER_NODE=0

# Worker per-instance memory cap in bytes (cgroup v2; 0 disables):
# CALCSIDE_INSTANCE_MEMORY_MAX=67108864

# Dev mode (INSECURE, anonymous access):
# CALCSIDE_DEV=true
# CALCSIDE_DEV_ALLOW_REMOTE=true

# Bootstrap-only local administrator: replace this username/password before deployment.
# After the first successful login, change the password in the console, not here.
CALCSIDE_ADMIN_USERNAME=wylswz@github.io
CALCSIDE_ADMIN_PASSWORD=changeit

# Public console address: the URL users actually open in their browser.
# The UI, API and Google OAuth callback all use this one address; it also determines
# which console may embed artifact previews. This is NOT the container listen address.
# Format: scheme + hostname + optional port, without a page path, query or fragment.
# Production example: https://console.example.com
# Google OAuth redirect URI for that example: https://console.example.com/auth/google/callback
# For HTTPS deployments, also set CALCSIDE_COOKIE_SECURE=true.
CALCSIDE_CONSOLE_ORIGIN=http://localhost:8080

# Optional isolated HTML preview address. Leave empty to disable rendered HTML;
# CSV/text/source previews, file downloads and ZIP exports still work.
# Production example: https://reports.example.net
# Enter the base address only, WITHOUT "*." or a snapshot ID. Calcside generates
# URLs such as https://<random-id>.reports.example.net/ for individual snapshots.
# To enable previews in production:
#   1. Use HTTPS for BOTH addresses and DIFFERENT registrable domains:
#      console.example.com + reports.example.net is valid;
#      console.example.com + reports.example.com is NOT isolated enough.
#   2. Point *.reports.example.net at your reverse proxy and provide a matching
#      wildcard TLS certificate. Setting this variable does not configure DNS or TLS.
#   3. Route the console host and all preview subdomains to the SAME calcside service
#      (Compose upstream calcside:8080), preserving the original Host header.
#   4. Do not share console cookies with previews. Exclude preview query strings
#      from proxy/CDN access logs: they contain short-lived bearer access tickets.
# See README.md "Configure isolated HTML previews" for localhost development
# and multi-replica routing requirements.
CALCSIDE_ARTIFACT_PREVIEW_BASE_URL=

# Keep false for sanitized, script-free HTML previews. Set true only when you need
# JavaScript charts/reports AND have configured the isolated preview address above.
# Users must still explicitly choose interactive preview in the console.
# Reports must be self-contained: external CDN scripts and fetch/XHR are blocked.
# Browser sandbox/CSP are NOT a strict no-egress or CPU/memory sandbox; keep false
# if arbitrary active HTML is unacceptable for your deployment.
CALCSIDE_ARTIFACT_ALLOW_SCRIPTS=false
