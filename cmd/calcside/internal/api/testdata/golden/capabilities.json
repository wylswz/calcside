{
  "body": {
    "capabilities": [
      {
        "config_fields": [
          {
            "default": 67108864,
            "doc": "max total bytes stored",
            "name": "quota_bytes",
            "type": "int"
          },
          {
            "default": 10000,
            "doc": "max number of files",
            "name": "max_files",
            "type": "int"
          },
          {
            "default": false,
            "doc": "reject all writes",
            "name": "read_only",
            "type": "bool"
          }
        ],
        "name": "fs",
        "ops": [
          {
            "doc": "read file contents as string",
            "name": "read",
            "params": [
              "path"
            ],
            "policy_args": {
              "path": "string"
            },
            "result_meta": {
              "bytes": "number"
            }
          },
          {
            "doc": "write string to file, creating parents",
            "name": "write",
            "params": [
              "path",
              "content"
            ],
            "policy_args": {
              "bytes": "number",
              "path": "string"
            },
            "result_meta": {
              "bytes": "number"
            }
          },
          {
            "doc": "append string to file, creating parents",
            "name": "append",
            "params": [
              "path",
              "content"
            ],
            "policy_args": {
              "bytes": "number",
              "path": "string"
            },
            "result_meta": {
              "bytes": "number"
            }
          },
          {
            "doc": "whether path exists",
            "name": "exists",
            "params": [
              "path"
            ],
            "policy_args": {
              "path": "string"
            }
          },
          {
            "doc": "dict{name,path,is_dir,size,mtime}",
            "name": "stat",
            "params": [
              "path"
            ],
            "policy_args": {
              "path": "string"
            },
            "result_meta": {
              "is_dir": "boolean",
              "size": "number"
            }
          },
          {
            "doc": "list direct children of dir",
            "name": "list",
            "params": [
              "dir"
            ],
            "policy_args": {
              "path": "string"
            },
            "result_meta": {
              "count": "number"
            }
          },
          {
            "doc": "recursive listing under dir",
            "name": "walk",
            "params": [
              "dir"
            ],
            "policy_args": {
              "path": "string"
            },
            "result_meta": {
              "count": "number"
            }
          },
          {
            "doc": "create dir and parents",
            "name": "mkdir",
            "params": [
              "path"
            ],
            "policy_args": {
              "path": "string"
            }
          },
          {
            "doc": "delete file or dir",
            "name": "delete",
            "params": [
              "path",
              "recursive"
            ],
            "policy_args": {
              "path": "string",
              "recursive": "boolean"
            },
            "result_meta": {
              "removed": "number"
            }
          }
        ]
      },
      {
        "config_fields": [
          {
            "default": 1048576,
            "doc": "output buffer cap",
            "name": "max_output_bytes",
            "type": "int"
          }
        ],
        "name": "io",
        "ops": [
          {
            "doc": "write args to output buffer, space separated, newline terminated",
            "name": "println",
            "policy_args": {
              "bytes": "number"
            },
            "result_meta": {
              "bytes": "number"
            }
          },
          {
            "doc": "attach a validated Vega-Lite spec dict to the exec result (max 8 per exec)",
            "name": "display",
            "policy_args": {
              "bytes": "number",
              "mark": "string",
              "rows": "number"
            },
            "result_meta": {
              "bytes": "number"
            }
          }
        ]
      },
      {
        "config_fields": [
          {
            "default": [],
            "doc": "exact host, *.suffix wildcard, or host:port; empty = any host, subject to selected policies (builtin.block_private_network blocks private/reserved IPs when selected)",
            "name": "allow_hosts",
            "type": "string_list"
          },
          {
            "default": [
              "GET",
              "POST"
            ],
            "doc": "permitted HTTP methods",
            "name": "methods",
            "type": "string_list"
          },
          {
            "default": 10485760,
            "doc": "response body cap",
            "name": "max_response_bytes",
            "type": "int"
          },
          {
            "default": 10000,
            "doc": "request timeout",
            "name": "timeout_ms",
            "type": "int"
          }
        ],
        "name": "net",
        "ops": [
          {
            "doc": "HTTP GET; returns {status,headers,body}; supports {{secrets.NAME}} placeholders; Accept-Encoding/Range/If-Range/TE headers are rejected",
            "name": "get",
            "params": [
              "url",
              "headers"
            ],
            "policy_args": {
              "host": "string",
              "method": "string",
              "port": "string",
              "scheme": "string",
              "secrets": "array\u003cstring\u003e",
              "url": "string"
            },
            "result_meta": {
              "bytes": "number",
              "secrets_injected": "number",
              "status": "number"
            }
          },
          {
            "doc": "HTTP POST; returns {status,headers,body}",
            "name": "post",
            "params": [
              "url",
              "body",
              "headers",
              "content_type"
            ],
            "policy_args": {
              "host": "string",
              "method": "string",
              "port": "string",
              "scheme": "string",
              "secrets": "array\u003cstring\u003e",
              "url": "string"
            },
            "result_meta": {
              "bytes": "number",
              "secrets_injected": "number",
              "status": "number"
            }
          },
          {
            "doc": "HTTP request with arbitrary method",
            "name": "request",
            "params": [
              "method",
              "url",
              "body",
              "headers"
            ],
            "policy_args": {
              "host": "string",
              "method": "string",
              "port": "string",
              "scheme": "string",
              "secrets": "array\u003cstring\u003e",
              "url": "string"
            },
            "result_meta": {
              "bytes": "number",
              "secrets_injected": "number",
              "status": "number"
            }
          },
          {
            "doc": "Streaming HTTP request; returns {status,headers,body}; body is a single-execution byte stream.",
            "name": "stream",
            "params": [
              "method",
              "url",
              "body",
              "headers"
            ],
            "policy_args": {
              "bytes": "number",
              "host": "string",
              "method": "string",
              "port": "string",
              "pulls": "number",
              "raw_bytes": "number",
              "scheme": "string",
              "secrets": "array\u003cstring\u003e",
              "status": "number",
              "stream_action": "string",
              "stream_id": "number",
              "stream_status": "string",
              "url": "string"
            },
            "result_meta": {
              "bytes": "number",
              "chunks": "number",
              "pulls": "number",
              "raw_bytes": "number",
              "secrets_injected": "number",
              "status": "number",
              "stream_id": "number",
              "stream_state": "string",
              "stream_status": "string"
            }
          }
        ]
      }
    ]
  },
  "status": 200
}
